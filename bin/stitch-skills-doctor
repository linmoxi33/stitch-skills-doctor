#!/usr/bin/env python3
"""stitch-skills-doctor: audit an Agent Skills pack by *executing* its artifacts.

Checks the contract an agent actually relies on: the paths and flags written in
SKILL.md must exist and be accepted by the scripts shipped next to it. Anything
that can be executed is executed (bash -n, node --check, py_compile, --help) in a
scrubbed temporary environment; no network access is used.

Exit codes: 0 = no finding at/above --fail-on, 1 = findings, 2 = usage/input error.
"""

import argparse
import ast
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

VERSION = "1.0.0"

SEVERITY = {
    "DOC_PATH_MISSING": "error",
    "DOC_TS_DIRECT_EXEC": "error",
    "DOC_FLAG_UNSUPPORTED": "error",
    "SCRIPT_SYNTAX_ERROR": "error",
    "SCRIPT_HELP_FAILS": "error",
    "SCRIPT_ORPHAN": "warning",
    "DOC_PATH_CLONE_DEPENDENT": "warning",
    "SCRIPT_DEP_MISSING": "warning",
    "SCRIPT_UNDECLARED_DEP": "warning",
}

DOC_DIRS = ("scripts", "resources", "references", "reference", "examples", "assets")
PATH_RE = re.compile(
    r"(?<![\w/.:-])((?:\./)?(?:" + "|".join(DOC_DIRS) + r")/[A-Za-z0-9_][A-Za-z0-9_./-]*\.[A-Za-z0-9]+)"
)
FENCE_RE = re.compile(r"```[a-zA-Z0-9_-]*\n(.*?)```", re.S)
FLAG_RE = re.compile(r"--[a-z][a-z0-9-]+")
RUNNER_TOKENS = {"node", "bash", "sh", "python", "python3", "npx", "npm", "pnpm", "yarn", "gh", "jq", "curl"}
STDLIB_HINT = re.compile(r"^(node:|os$|sys$|re$|json$|path$|fs$|argparse$|hashlib$|subprocess$|tempfile$|shutil$)")


def read_text(path):
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        return fh.read()


def frontmatter(text):
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    if end < 0:
        return {}
    body, out, key = text[3:end], {}, None
    for line in body.splitlines():
        if not line.strip():
            continue
        if line[:1] not in " \t" and ":" in line:
            key, _, val = line.partition(":")
            key = key.strip()
            out[key] = val.strip().strip('"').strip("'")
        elif key and line[:1] in " \t":
            out[key] = (out.get(key, "") + " " + line.strip()).strip()
    return out


def iter_skills(pack):
    skills = []
    for root, dirs, files in os.walk(pack):
        dirs[:] = sorted(d for d in dirs if d not in (".git", "node_modules", "__pycache__", ".venv"))
        if "SKILL.md" in files:
            skills.append(root)
    return sorted(skills)


def script_files(skill_dir):
    base = os.path.join(skill_dir, "scripts")
    if not os.path.isdir(base):
        return []
    out = []
    for root, dirs, files in os.walk(base):
        dirs[:] = sorted(d for d in dirs if d not in ("node_modules", "__pycache__"))
        for name in sorted(files):
            out.append(os.path.join(root, name))
    return out


def doc_bundle(skill_dir):
    """SKILL.md plus any sibling README.md, used as the documentation surface."""
    parts = []
    for name in ("SKILL.md", "README.md"):
        path = os.path.join(skill_dir, name)
        if os.path.isfile(path):
            parts.append(read_text(path))
    return "\n".join(parts)


def scrub_env(home):
    return {
        "PATH": os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin"),
        "HOME": home,
        "LANG": "C.UTF-8",
        "PYTHONDONTWRITEBYTECODE": "1",
    }


def run(cmd, cwd, home, timeout=10):
    try:
        proc = subprocess.run(
            cmd, cwd=cwd, env=scrub_env(home), capture_output=True, text=True, timeout=timeout
        )
        return proc.returncode, (proc.stdout or ""), (proc.stderr or "")
    except FileNotFoundError:
        return 127, "", "executable-not-found"
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except OSError as exc:  # pragma: no cover - environment specific
        return 126, "", str(exc)


def syntax_check(path, tmp, home):
    """Execute a real syntax check with the interpreter that ships the file."""
    ext = os.path.splitext(path)[1].lower()
    if ext == ".py":
        rc, out, err = run([sys.executable, "-m", "py_compile", path], tmp, home)
    elif ext in (".js", ".mjs", ".cjs"):
        rc, out, err = run(["node", "--check", path], tmp, home)
    elif ext in (".sh", ".bash"):
        rc, out, err = run(["bash", "-n", path], tmp, home)
    elif ext in (".json",):
        try:
            json.loads(read_text(path))
            return None
        except json.JSONDecodeError as exc:
            return "json: %s" % exc
    else:
        return None
    if rc != 0:
        tail = (err or out).strip().splitlines()
        return " ".join(tail[-3:])[:300] or "exit %d" % rc
    return None


def python_flags(path, tmp, home):
    """Real probe: run `--help` and read the accepted long options."""
    rc, out, err = run([sys.executable, path, "--help"], tmp, home)
    text = out + "\n" + err
    flags = set(FLAG_RE.findall(text))
    if rc == 0 and flags:
        return flags, None
    mod = re.search(r"No module named '([^']+)'", err)
    if mod:
        return set(), "module:" + mod.group(1)
    return flags, None


def source_flags(path):
    try:
        text = read_text(path)
    except OSError:
        return set()
    return set(FLAG_RE.findall(text))


def declared_dep_probe(path, tmp, home):
    """For python scripts, ask the interpreter which third-party modules import fails on."""
    src = read_text(path)
    try:
        tree = ast.parse(src)
    except SyntaxError:
        return []
    mods = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            mods += [a.name.split(".")[0] for a in node.names]
        elif isinstance(node, ast.ImportFrom) and node.module and node.level == 0:
            mods.append(node.module.split(".")[0])
    missing = []
    for mod in sorted(set(mods)):
        if STDLIB_HINT.match(mod):
            continue
        rc, out, err = run([sys.executable, "-c", "import " + mod], tmp, home)
        if rc != 0:
            missing.append(mod)
    return missing


def js_deps(path):
    src = read_text(path)
    deps = set()
    for m in re.finditer(r"""(?:from|require\()\s*['"]([^'"]+)['"]""", src):
        spec = m.group(1)
        if spec.startswith(".") or spec.startswith("node:") or spec.startswith("/"):
            continue
        deps.add(spec.split("/")[0] if not spec.startswith("@") else "/".join(spec.split("/")[:2]))
    return sorted(deps)


SCRIPT_TOKEN_RE = re.compile(r"(?<![\w/.-])((?:\./)?[A-Za-z0-9_./-]+\.(?:py|js|mjs|cjs|sh|bash|ts|tsx))")


def invocation_blocks(text):
    """Fenced blocks that invoke a local script, plus the script paths each block names."""
    blocks = []
    for m in FENCE_RE.finditer(text):
        body = m.group(1)
        tokens = sorted(set(SCRIPT_TOKEN_RE.findall(body)))
        if not tokens:
            continue
        blocks.append((body, tokens))
    return blocks


def resolve_script(token, skill, pack):
    """Resolve a documented script path against the skill dir, then the pack root."""
    token = token.lstrip("./")
    parts = token.split("/")
    for cut in range(0, len(parts)):
        for base in (skill, pack):
            path = os.path.join(base, *parts[cut:])
            if os.path.isfile(path):
                return path
    return None


def npm_referenced_scripts(skill):
    """Basenames reachable through a package.json `scripts` entry."""
    pkg = os.path.join(skill, "package.json")
    if not os.path.isfile(pkg):
        return set()
    try:
        data = json.loads(read_text(pkg))
    except json.JSONDecodeError:
        return set()
    out = set()
    for cmd in (data.get("scripts") or {}).values():
        for tok in str(cmd).split():
            if tok.endswith((".js", ".mjs", ".cjs", ".sh", ".py")):
                out.add(os.path.basename(tok))
    return out


def first_tokens(block):
    toks = []
    for line in block.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        line = line.lstrip("$ ").strip()
        toks.append(line.split()[0] if line.split() else "")
    return toks


def audit(pack, execute=True):
    findings = []
    pack = os.path.abspath(pack)
    skills = iter_skills(pack)
    pack_name = os.path.basename(os.path.normpath(pack))
    executed = 0
    tmp = tempfile.mkdtemp(prefix="ssd-")
    home = os.path.join(tmp, "home")
    os.makedirs(home, exist_ok=True)
    try:
        for skill in skills:
            rel = os.path.relpath(skill, pack)
            doc = doc_bundle(skill)
            scripts = [p for p in script_files(skill) if os.path.basename(p) not in ("package-lock.json",)]
            script_rel = {os.path.relpath(p, skill).replace(os.sep, "/"): p for p in scripts}

            # --- documented relative paths must exist in the skill directory
            for raw in sorted(set(PATH_RE.findall(doc))):
                token = raw[2:] if raw.startswith("./") else raw
                target = os.path.join(skill, token)
                if os.path.exists(target):
                    continue
                elsewhere = None
                for other in skills:
                    if other == skill:
                        continue
                    cand = os.path.join(other, token)
                    if os.path.exists(cand):
                        elsewhere = os.path.relpath(cand, pack).replace(os.sep, "/")
                        break
                msg = "SKILL.md references `%s` but that path does not exist under the skill directory" % token
                if elsewhere:
                    msg += "; it only exists at `%s`" % elsewhere
                findings.append(
                    {
                        "rule": "DOC_PATH_MISSING",
                        "severity": SEVERITY["DOC_PATH_MISSING"],
                        "skill": rel,
                        "path": token,
                        "message": msg,
                        "witness": "%s/SKILL.md:%s" % (rel, token),
                    }
                )

            # --- repo-relative paths that only resolve when cwd is the clone's parent
            for m in re.finditer(r"(?<![\w/.-])([A-Za-z0-9_.-]+)/(?:plugins|\.agents)/[A-Za-z0-9_./-]+", doc):
                token = m.group(0)
                head, _, rest = token.partition("/")
                if head == pack_name or os.path.exists(os.path.join(pack, rest)):
                    sev = SEVERITY["DOC_PATH_CLONE_DEPENDENT"] if head == pack_name else "error"
                    findings.append(
                        {
                            "rule": "DOC_PATH_CLONE_DEPENDENT",
                            "severity": sev,
                            "skill": rel,
                            "path": token,
                            "message": "documented command path is repository-relative: it only resolves "
                            "when the working directory is the parent of a checkout named `%s`" % head,
                            "witness": token,
                        }
                    )

            # --- every shipped script that is never referenced anywhere in the docs
            npm_scripts = npm_referenced_scripts(skill)
            doc_lower = doc
            for script_relpath in sorted(script_rel):
                base = os.path.basename(script_relpath)
                if base in doc:
                    continue
                if base in npm_scripts:
                    # reachable through a package.json entry; only fine if that entry is documented
                    pkg = os.path.join(skill, "package.json")
                    try:
                        entries = json.loads(read_text(pkg)).get("scripts") or {}
                    except (OSError, json.JSONDecodeError):
                        entries = {}
                    reachable = [
                        name for name, cmd in entries.items() if base in str(cmd) and ("npm run " + name) in doc
                    ]
                    if reachable:
                        continue
                findings.append(
                    {
                        "rule": "SCRIPT_ORPHAN",
                        "severity": SEVERITY["SCRIPT_ORPHAN"],
                        "skill": rel,
                        "path": script_relpath,
                        "message": "script ships in the skill but SKILL.md/README.md never mentions it (not even "
                        "through a documented npm script), so an agent has no reason to run it",
                        "witness": "%s/%s" % (rel, script_relpath),
                    }
                )

            # --- syntax checks by executing the interpreter
            for script_relpath, path in sorted(script_rel.items()):
                err = syntax_check(path, tmp, home) if execute else None
                if execute:
                    executed += 1
                if err:
                    findings.append(
                        {
                            "rule": "SCRIPT_SYNTAX_ERROR",
                            "severity": SEVERITY["SCRIPT_SYNTAX_ERROR"],
                            "skill": rel,
                            "path": script_relpath,
                            "message": "interpreter rejected the script: %s" % err,
                            "witness": "%s/%s" % (rel, script_relpath),
                        }
                    )

            # --- python --help probe (per script, so flags are attributed to the script they belong to)
            own_flags = {}
            for script_relpath, path in sorted(script_rel.items()):
                flags = set()
                if script_relpath.endswith(".py") and execute:
                    probed, err = python_flags(path, tmp, home)
                    flags |= probed
                    if err and err.startswith("module:"):
                        mod = err.split(":", 1)[1]
                        findings.append(
                            {
                                "rule": "SCRIPT_DEP_MISSING",
                                "severity": SEVERITY["SCRIPT_DEP_MISSING"],
                                "skill": rel,
                                "path": script_relpath,
                                "message": "documented script cannot start offline: `%s` is not installed and "
                                "the skill never tells the agent to install it" % mod,
                                "witness": "%s/%s --help" % (rel, script_relpath),
                            }
                        )
                flags |= source_flags(path)
                own_flags[path] = flags

            # --- documented flags must be accepted by the script that the same block invokes
            for body, tokens in invocation_blocks(doc):
                accepted = set()
                unresolved = []
                for token in tokens:
                    resolved = resolve_script(token, skill, pack)
                    if resolved is None:
                        unresolved.append(token)
                        continue
                    if resolved not in own_flags:
                        extra = source_flags(resolved)
                        if resolved.endswith(".py") and execute:
                            probe, _err = python_flags(resolved, tmp, home)
                            extra |= probe
                        own_flags[resolved] = extra
                    accepted |= own_flags[resolved]
                for flag in sorted(set(FLAG_RE.findall(body))):
                    if flag in accepted:
                        continue
                    note = ""
                    if not accepted and unresolved:
                        note = " (the block names `%s`, which the pack does not ship)" % unresolved[0]
                    findings.append(
                        {
                            "rule": "DOC_FLAG_UNSUPPORTED",
                            "severity": SEVERITY["DOC_FLAG_UNSUPPORTED"],
                            "skill": rel,
                            "path": flag,
                            "message": "documented invocation uses `%s`, but the script that block invokes does "
                            "not parse it (probed with `--help` and source scan)%s" % (flag, note),
                            "witness": "%s: %s" % (rel, flag),
                        }
                    )

            # --- third-party deps that the docs never mention
            dep_text = doc.lower()
            for script_relpath, path in sorted(script_rel.items()):
                deps = []
                if script_relpath.endswith(".py"):
                    deps = declared_dep_probe(path, tmp, home) if execute else []
                elif script_relpath.endswith((".js", ".mjs", ".cjs", ".ts")):
                    deps = js_deps(path)
                for dep in deps:
                    if dep.lower() in dep_text or dep in STDLIB_HINT.pattern:
                        continue
                    findings.append(
                        {
                            "rule": "SCRIPT_UNDECLARED_DEP",
                            "severity": SEVERITY["SCRIPT_UNDECLARED_DEP"],
                            "skill": rel,
                            "path": script_relpath,
                            "message": "script imports `%s` but the skill documentation never names it, so the "
                            "install step for an agent following the doc is incomplete" % dep,
                            "witness": "%s/%s -> %s" % (rel, script_relpath, dep),
                        }
                    )

            # --- a .ts/.tsx script invoked directly as if it were executable
            for block, _tokens in invocation_blocks(doc):
                for tok in first_tokens(block):
                    if tok.endswith((".ts", ".tsx")) and "/" in tok:
                        findings.append(
                            {
                                "rule": "DOC_TS_DIRECT_EXEC",
                                "severity": SEVERITY["DOC_TS_DIRECT_EXEC"],
                                "skill": rel,
                                "path": tok,
                                "message": "documented invocation starts with a TypeScript path; `node` cannot run "
                                "it and the doc never names a TS runner",
                                "witness": "%s: %s" % (rel, tok),
                            }
                        )
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    uniq = {}
    for f in findings:
        uniq[(f["rule"], f["skill"], f["path"], f["message"])] = f
    out = [uniq[k] for k in sorted(uniq)]
    by_rule = {}
    by_sev = {"error": 0, "warning": 0, "info": 0}
    for f in out:
        by_rule[f["rule"]] = by_rule.get(f["rule"], 0) + 1
        by_sev[f["severity"]] = by_sev.get(f["severity"], 0) + 1
    digest = hashlib.sha256(
        json.dumps([[f["rule"], f["skill"], f["path"], f["message"]] for f in out], sort_keys=True).encode()
    ).hexdigest()
    return {
        "tool": "stitch-skills-doctor",
        "version": VERSION,
        "pack": os.path.abspath(pack),
        "summary": {
            "skills": len(skills),
            "scripts": sum(len(script_files(s)) for s in skills),
            "findings": len(out),
            "by_severity": by_sev,
            "by_rule": dict(sorted(by_rule.items())),
            "executed_probes": executed,
        },
        "findings": out,
        "deterministic_sha256": digest,
        "verdict": "fail" if by_sev["error"] else ("warn" if by_sev["warning"] else "pass"),
    }


def render(report):
    lines = []
    s = report["summary"]
    lines.append("stitch-skills-doctor %s" % report["version"])
    lines.append(
        "pack=%s skills=%d scripts=%d executed_probes=%d verdict=%s"
        % (report["pack"], s["skills"], s["scripts"], s["executed_probes"], report["verdict"])
    )
    lines.append("findings=%d %s" % (s["findings"], json.dumps(s["by_severity"], sort_keys=True)))
    for f in report["findings"]:
        lines.append("  [%s] %-24s %s :: %s" % (f["severity"], f["rule"], f["skill"], f["message"]))
    lines.append("sha256=%s" % report["deterministic_sha256"])
    return "\n".join(lines)


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="stitch-skills-doctor",
        description="Audit an Agent Skills pack by executing its shipped scripts and matching SKILL.md against them.",
    )
    ap.add_argument("--pack", required=False, help="path to the skills pack repository root")
    ap.add_argument("--json", action="store_true", help="emit machine-readable JSON on stdout")
    ap.add_argument(
        "--fail-on",
        choices=["error", "warning", "never"],
        default="error",
        help="lowest severity that makes the process exit 1 (default: error)",
    )
    ap.add_argument("--no-exec", action="store_true", help="skip executable probes (syntax/--help/dep imports)")
    ap.add_argument("--version", action="version", version="stitch-skills-doctor " + VERSION)
    args = ap.parse_args(argv)

    if not args.pack:
        sys.stderr.write("error: --pack is required\n")
        return 2
    if not os.path.isdir(args.pack):
        sys.stderr.write("error: --pack is not a directory: %s\n" % args.pack)
        return 2
    if not iter_skills(args.pack):
        sys.stderr.write("error: no SKILL.md found under %s\n" % args.pack)
        return 2

    report = audit(args.pack, execute=not args.no_exec)
    if args.json:
        sys.stdout.write(json.dumps(report, indent=2, sort_keys=True) + "\n")
    else:
        sys.stdout.write(render(report) + "\n")

    sev = report["summary"]["by_severity"]
    if args.fail_on == "never":
        return 0
    if args.fail_on == "warning":
        return 1 if (sev["error"] or sev["warning"]) else 0
    return 1 if sev["error"] else 0


if __name__ == "__main__":
    sys.exit(main())
